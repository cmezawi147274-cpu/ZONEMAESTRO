// Data model for the REAL cloud backend that this portal's src/lib/api/*
// modules talk to once NEXT_PUBLIC_USE_MOCK_API=false. Not used while running
// in mock mode. Provided as the source of truth for standing up the actual
// API service (see README "Backend & Windows MusicServer Integration").
//
// Run against a PostgreSQL 15+ instance, e.g. the one in docker-compose.yml.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ORGANIZATION_ADMIN
  LOCATION_MANAGER
  VIEWER
}

enum OrganizationPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum ServerStatus {
  ONLINE
  OFFLINE
  WARNING
  UPDATING
  UNKNOWN
}

enum SyncStatus {
  AVAILABLE_IN_CLOUD
  QUEUED_FOR_SYNC
  SYNCING
  CACHED_ON_SERVER
  FAILED
}

enum CommandStatus {
  PENDING
  SENT
  EXECUTING
  SUCCESS
  FAILED
  TIMEOUT
}

enum CommandType {
  SYNC_MUSIC
  SYNC_CONFIG
  RESTART_SERVICE
  PLAY
  PAUSE
  STOP
  NEXT
  PREVIOUS
  SET_VOLUME
  MUTE
  UNMUTE
  REBOOT_SERVER
}

enum ZonePlaybackState {
  PLAYING
  PAUSED
  STOPPED
  OFFLINE
}

enum PlaylistTargetType {
  ORGANIZATION
  LOCATION
  SERVER
  ZONE
}

enum LogLevel {
  INFO
  WARN
  ERROR
  DEBUG
}

enum AlertSeverity {
  info
  warning
  critical
}

enum CommandSource {
  USER
  SUPER_ADMIN
  SCHEDULE
}

enum PrayerName {
  FAJR
  DHUHR
  ASR
  MAGHRIB
  ISHA
}

model User {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  passwordHash   String
  role           Role
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  refreshTokens  RefreshToken[]
  createdAt      DateTime       @default(now())
  lastLoginAt    DateTime?

  @@index([organizationId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}

model Organization {
  id           String             @id @default(cuid())
  name         String
  slug         String             @unique
  contactName  String
  contactEmail String
  plan         OrganizationPlan   @default(PROFESSIONAL)
  status       OrganizationStatus @default(ACTIVE)
  createdAt    DateTime           @default(now())

  users        User[]
  locations    Location[]
  servers      MusicServer[]
  playlists    Playlist[]
  prayerConfig PrayerConfig?

  @@index([slug])
}

model Location {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  address        String
  city           String
  region         String
  country        String
  timezone       String
  createdAt      DateTime     @default(now())

  servers MusicServer[]
  zones   Zone[]

  @@index([organizationId])
}

model MusicServer {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationId       String
  location         Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name             String
  status           ServerStatus @default(UNKNOWN)
  version          String?
  os               String?
  ipAddress        String?
  // Pairing: a short-lived code the on-site technician enters into the
  // Windows MusicServer installer. The server authenticates that exchange
  // and issues its own long-lived agent credential — no inbound ports ever
  // need to be opened on the restaurant network.
  pairingCodeHash  String?
  pairingExpiresAt DateTime?
  agentTokenHash   String?
  pairedAt         DateTime?
  lastHeartbeatAt  DateTime?
  cpuPercent       Float        @default(0)
  ramPercent       Float        @default(0)
  diskPercent      Float        @default(0)
  diskFreeGb       Float        @default(0)
  diskTotalGb      Float        @default(0)
  cachedTracks     Int          @default(0)
  cachedSizeGb     Float        @default(0)
  createdAt        DateTime     @default(now())

  zones          Zone[]
  commands       RemoteCommand[]
  logs           LogEntry[]
  trackSyncState TrackSyncState[]
  alerts         Alert[]

  @@index([organizationId])
  @@index([locationId])
}

model Zone {
  id                String            @id @default(cuid())
  serverId          String
  server            MusicServer       @relation(fields: [serverId], references: [id], onDelete: Cascade)
  locationId        String
  location          Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name              String
  playbackState     ZonePlaybackState @default(OFFLINE)
  currentPlaylistId String?
  currentPlaylist   Playlist?         @relation(fields: [currentPlaylistId], references: [id], onDelete: SetNull)
  currentTrackId    String?
  volume            Int               @default(50)
  muted             Boolean           @default(false)
  updatedAt         DateTime          @updatedAt

  // Prayer Mode
  prayerModeEnabled      Boolean            @default(true)
  pausedByPrayer         PrayerName?
  prePrayerPlaybackState ZonePlaybackState?
  prePrayerPlaylistId    String?
  prePrayerTrackId       String?

  // Super Admin / command reconciliation
  commandSequence     Int       @default(0)
  lastAppliedSequence Int       @default(0)
  lastOverrideAt      DateTime?

  schedules Schedule[]
  commands  RemoteCommand[]

  @@index([serverId])
  @@index([locationId])
}

model Track {
  id           String   @id @default(cuid())
  title        String
  artist       String
  album        String
  genre        String
  durationSec  Int
  fileSizeMb   Float
  storageKey   String // object storage path/key for the audio file
  uploadedById String
  uploadedAt   DateTime @default(now())

  // Folder library grouping. Optional — tracks with no folder show up as
  // "Unfiled". Deleting a folder never deletes its tracks: the FK falls
  // back to null.
  folderId String?
  folder   MusicFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  playlistTracks  PlaylistTrack[]
  trackSyncStates TrackSyncState[]

  // Search: query with Postgres `ILIKE` / trigram indexes (pg_trgm) or wire
  // up a dedicated search index (e.g. Meilisearch) — Prisma's `@@fulltext`
  // index type targets MySQL/MongoDB, not PostgreSQL.
  @@index([genre])
  @@index([folderId])
}

/// A user-defined grouping of Tracks in the cloud music library.
model MusicFolder {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  tracks Track[]
}

model Playlist {
  id             String        @id @default(cuid())
  name           String
  description    String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tracks      PlaylistTrack[]
  assignments PlaylistAssignment[]
  zones       Zone[]
  schedules   Schedule[]

  @@index([organizationId])
}

model PlaylistTrack {
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  trackId    String
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  position   Int

  @@id([playlistId, trackId])
  @@index([playlistId, position])
}

model PlaylistAssignment {
  id         String             @id @default(cuid())
  playlistId String
  playlist   Playlist           @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  targetType PlaylistTargetType
  targetId   String
  assignedAt DateTime           @default(now())

  @@index([playlistId])
  @@index([targetType, targetId])
}

model TrackSyncState {
  trackId         String
  track           Track       @relation(fields: [trackId], references: [id], onDelete: Cascade)
  serverId        String
  server          MusicServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  status          SyncStatus  @default(AVAILABLE_IN_CLOUD)
  progressPercent Int         @default(0)
  errorMessage    String?
  updatedAt       DateTime    @updatedAt

  @@id([trackId, serverId])
  @@index([serverId, status])
}

model Schedule {
  id         String   @id @default(cuid())
  zoneId     String
  zone       Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  name       String
  startTime  String // "HH:mm", evaluated in the location's timezone
  endTime    String
  days       String[] // subset of MON..SUN
  priority   Int      @default(1)
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([zoneId])
}

model RemoteCommand {
  id            String        @id @default(cuid())
  serverId      String
  server        MusicServer   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  zoneId        String?
  zone          Zone?         @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  type          CommandType
  payload       Json?
  status        CommandStatus @default(PENDING)
  source        CommandSource @default(USER)
  sequence      Int?
  issuedById    String
  issuedAt      DateTime      @default(now())
  sentAt        DateTime?
  executingAt   DateTime?
  completedAt   DateTime?
  resultMessage String?

  @@index([serverId, status])
}

/// Singleton-per-organization Prayer Mode configuration. Location fields are
/// resolved server-side from Country + City (see src/lib/prayer/locations.ts)
/// — latitude/longitude/timezone are internal and never surfaced in the UI.
model PrayerConfig {
  id                  String       @id @default(cuid())
  organizationId      String       @unique
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enabled             Boolean      @default(false)
  country             String?
  city                String?
  latitude            Float?
  longitude           Float?
  timezone            String?
  calculationMethodId Int          @default(3)
  prayers             Json // Record<PrayerName, { enabled, offsetMinutes, pauseDurationMinutes }>
  updatedAt           DateTime     @updatedAt
}

model LogEntry {
  id        String      @id @default(cuid())
  serverId  String
  server    MusicServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  level     LogLevel
  message   String
  source    String
  timestamp DateTime    @default(now())

  @@index([serverId, timestamp])
}

model Alert {
  id           String        @id @default(cuid())
  severity     AlertSeverity
  title        String
  message      String
  serverId     String?
  server       MusicServer?  @relation(fields: [serverId], references: [id], onDelete: SetNull)
  locationId   String?
  createdAt    DateTime      @default(now())
  acknowledged Boolean       @default(false)

  @@index([serverId])
  @@index([acknowledged])
}
