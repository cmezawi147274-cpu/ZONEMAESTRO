# ==============================================================================
# Cloud Music Management Portal (CMMP) — environment configuration
#
# Copy this file to .env.local for local development, or .env for a Docker /
# production deployment, then fill in real values. Never commit a populated
# .env file — only .env.example is tracked in git.
# ==============================================================================

# ------------------------------------------------------------------------------
# API MODE
# ------------------------------------------------------------------------------
# When true, the entire portal runs against the in-browser mock data layer
# (src/lib/mock/*) — no backend, database, or Windows MusicServer required.
# This is what lets the UI be built and demoed before the real cloud API and
# MusicServer integration exist. Set to false once NEXT_PUBLIC_API_URL points
# at a real deployment of the backend described in this repo's API contract.
NEXT_PUBLIC_USE_MOCK_API=false

# ------------------------------------------------------------------------------
# REAL BACKEND ENDPOINTS (ignored while NEXT_PUBLIC_USE_MOCK_API=true)
# ------------------------------------------------------------------------------
# Base URL of the cloud REST API (see src/lib/api/client.ts).
NEXT_PUBLIC_API_URL=https://api.your-domain.com/api

# WebSocket / SignalR-bridge gateway used for real-time events (server
# connect/disconnect, heartbeats, zone + playback changes, sync progress,
# command completion). See src/lib/realtime/client.ts.
NEXT_PUBLIC_WS_URL=wss://api.your-domain.com/realtime

# ------------------------------------------------------------------------------
# MOCK-MODE-ONLY DEV SECRET
# ------------------------------------------------------------------------------
# Used only to sign demo JWTs client-side when NEXT_PUBLIC_USE_MOCK_API=true,
# purely so the login/session UX matches the real flow. NOT a real secret —
# never reuse this value for anything security-sensitive. Ignored in real mode.
NEXT_PUBLIC_MOCK_JWT_SECRET=cmmp-mock-mode-development-secret-do-not-use-in-prod

# ==============================================================================
# The variables below are consumed by the REAL backend in `backend/`
# (Fastify + Prisma + socket.io — see backend/README.md). They are not read by
# the Next.js portal itself, but live here so one .env configures the whole
# cloud stack that docker-compose.yml brings up.
# ==============================================================================

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cmmp
POSTGRES_USER=cmmp
POSTGRES_PASSWORD=change-me-before-deploying
DATABASE_URL=postgresql://cmmp:change-me-before-deploying@postgres:5432/cmmp?schema=public

# ------------------------------------------------------------------------------
# AUTH / JWT (server-side only — never expose these with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Generate strong random values, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-a-different-long-random-value
# Read by backend/src/lib/env.ts with exactly these names and units.
JWT_ACCESS_TOKEN_TTL_SEC=900
JWT_REFRESH_TOKEN_TTL_DAYS=30

# ------------------------------------------------------------------------------
# WINDOWS MUSICSERVER INTEGRATION
# ------------------------------------------------------------------------------
# This backend IS the cloud (runs on Linux); the compiled win-x64
# MusicServer.Api service on each restaurant PC is a client of it —
# outbound HTTPS only, no inbound ports ever opened on the restaurant
# network. See backend/README.md "Windows MusicServer agent protocol".
#
# The public base URL THIS backend is reachable at. This is exactly what a
# technician sets as `Cloud.ApiBaseUrl` in the Windows service's
# C:\Program Files\Music Server\Service\appsettings.json — a real
# https://... host, never http://127.0.0.1:5090 (that's the agent's own
# loopback API, a different local-only surface this backend does not
# depend on and must not be treated as the cloud).
PUBLIC_API_URL=https://api.your-domain.com
# Master switch for the whole agent surface (POST/GET /api/pairing/*,
# /api/server/*, the MusicServerHub WebSocket). Set false to take a
# backend instance out of agent traffic without touching the portal API.
MUSIC_SERVER_AGENT_ALLOWED=true
# Path prefix the agent-facing routes are mounted under. The default
# matches the paths the compiled agent was observed calling — change only
# if fronting this behind a path-rewriting proxy.
AGENT_API_PREFIX=/api
# How long a generated pairing code stays valid before it must be regenerated.
SERVER_PAIRING_CODE_TTL_MINUTES=60
# How long an unpaired server row (registered but never connected) survives
# past its code's own expiry before it's deleted as abandoned — independent
# of the TTL above. An expired code alone does not delete the row; a fresh
# code can still be issued (POST /servers/:id/pairing-code) any time before
# this window elapses.
SERVER_UNPAIRED_RETENTION_DAYS=7
# Heartbeat interval the agent is expected to honor; servers with no
# heartbeat (and no open MusicServerHub socket) for
# SERVER_OFFLINE_AFTER_MISSED_BEATS x this interval are marked OFFLINE.
SERVER_HEARTBEAT_INTERVAL_SECONDS=15
SERVER_OFFLINE_AFTER_MISSED_BEATS=3
# How long a portal zone command (PLAY/PAUSE/STOP/NEXT/PREVIOUS/
# SET_VOLUME/MUTE/UNMUTE) waits for the agent's ack before failing.
AGENT_COMMAND_ACK_TIMEOUT_MS=3000

# ------------------------------------------------------------------------------
# CLOUD MUSIC STORAGE
# ------------------------------------------------------------------------------
# Uploaded audio is stored on the backend's own filesystem and served from
# `<PUBLIC_API_URL>/media/music/<storageKey>` — the URL each Windows agent
# downloads from during music sync. In Docker this path is the `music-data`
# volume (docker-compose.yml); back it up like any other stateful volume.
# Relative paths are resolved against the backend's working directory.
MUSIC_STORAGE_DIR=/app/data/music

# ------------------------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------------------------
NODE_ENV=production
# Port the *portal* container listens on inside its image. The backend's own
# port is set to 4000 by docker-compose.yml regardless of this value, so one
# shared .env can configure both.
PORT=3000
# Host port the portal and backend are published on.
APP_PORT=3000
BACKEND_PORT=4000
# Comma-separated list of origins allowed to call the API / connect via WS.
# Must include the portal's own public origin, or every browser request the
# portal makes to the backend is blocked by CORS.
CORS_ALLOWED_ORIGINS=https://portal.your-domain.com
