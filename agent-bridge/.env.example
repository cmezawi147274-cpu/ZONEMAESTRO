# Copy to .env. Everything here is optional: with the defaults below the
# agent starts, serves its control panel on http://127.0.0.1:8899, and waits
# for you to paste a pairing code there. Filling PAIRING_CODE in is only for
# unattended/scripted installs.
#
# After a successful pairing the agent token and the cloud URL are cached in
# agent-state.json, and neither PAIRING_CODE nor CMMP_API_URL is read again.
# Delete agent-state.json (or use "Unpair from cloud" in the panel) to re-pair.

# The CMMP cloud backend. In production this is your public https:// host.
CMMP_API_URL=http://127.0.0.1:4000/api

# The local MusicServer service's own REST API on this machine.
LOCAL_API_URL=http://127.0.0.1:8765/api

# From CMMP: Location -> Register Server -> copy the pairing code shown.
PAIRING_CODE=

# --- Local control panel ------------------------------------------------------
# The Setup + Zones UI this agent serves itself. It has no authentication, so
# it is bound to loopback by default; only change LOCAL_UI_HOST if the machine
# is on a trusted network and you understand the consequence.
LOCAL_UI_PORT=8899
LOCAL_UI_HOST=127.0.0.1

# --- Loop intervals -----------------------------------------------------------
COMMAND_POLL_MS=1500
TRACK_SYNC_MS=20000
HEARTBEAT_INTERVAL_SECONDS=15
